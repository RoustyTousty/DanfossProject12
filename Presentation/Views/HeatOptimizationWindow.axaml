<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeatOptimization.Presentation.ViewModels"
			 x:Class="HeatOptimization.Presentation.Views.HeatOptimizationView"
			 x:DataType="vm:HeatOptimizationViewModel">

    <Border Background="#0B0F14" Padding="20">
		<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="280" />
		</Grid.ColumnDefinitions>

           <!-- LEFT -->
			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Text="Dashboard"
						   FontSize="24"
						   FontWeight="Bold"
						   Foreground="White"/>

				<Border Grid.Row="1" Background="#11161C"
						CornerRadius="20"
						Padding="20">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding Boilers}" Grid.Row="0" BorderThickness="0" Background="Transparent" x:Name="BoilerListBox">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:BoilerItemViewModel">
								<Border Background="#3A4048" CornerRadius="20" Padding="15" Margin="0,0,0,10">
									<Grid ColumnDefinitions="120,*">
                                        <Border Grid.Column="0" Width="100" Height="100" Background="#D9D9D9" CornerRadius="10">
											<!-- More detailed vector boiler icon drawn with shapes -->
											<Viewbox Stretch="Uniform">
												<Image Source="avares://Presentation/Assets/BoilerIcon.png"/>
											</Viewbox>
										</Border>
										<StackPanel Grid.Column="1" Spacing="5">
											<TextBlock Text="{Binding Name, TargetNullValue='N/A', FallbackValue='N/A'}"
													   Foreground="White"
													   FontWeight="Bold"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding Type, TargetNullValue='N/A', FallbackValue='N/A'}"
													   Foreground="White"/>

											<TextBlock Text="{Binding DisplayMaxHeat, StringFormat='Max Heat: {0}', TargetNullValue='Max Heat: N/A', FallbackValue='Max Heat: N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding TotalHeatProduced, StringFormat='Total Heat Produced (MWh) : {0:F2}', TargetNullValue='Total Heat Produced (MWh) : N/A', FallbackValue='Total Heat Produced (MWh) : N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding MaxElectricityMW, StringFormat='Max Electricity (MW) : {0}', TargetNullValue='Max Electricity (MW) : N/A', FallbackValue='Max Electricity (MW) : N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding DisplayBaseProductionCost, StringFormat='Production cost : {0}', TargetNullValue='Production cost : N/A', FallbackValue='Production cost : N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding CO2EmissionsKg, StringFormat='CO2 Emissions (Kg) : {0}', TargetNullValue='CO2 Emissions (Kg) : N/A', FallbackValue='CO2 Emissions (Kg) : N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding GasConsumptionMWh, StringFormat='Gas Consumption (MWh) : {0}', TargetNullValue='Gas Consumption (MWh) : N/A', FallbackValue='Gas Consumption (MWh) : N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>

											<TextBlock Text="{Binding OilConsumptionMWh, StringFormat='Oil Consumption (MWh) : {0}', TargetNullValue='Oil Consumption (MWh) : N/A', FallbackValue='Oil Consumption (MWh) : N/A'}"
													   Foreground="White"
													   TextWrapping="Wrap"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
               </Border>

			</Grid>

		<!-- RIGHT -->
		<Border Grid.Column="1"
                Background="#11161C"
                CornerRadius="20"
                Padding="20"
                Margin="20,40,0,0">

			<StackPanel Spacing="10">

				<TextBlock Text="Unit Settings"
                           Foreground="White"
                           FontWeight="Bold"/>

                  <StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="Currency" Foreground="White"/>
                      <ComboBox Width="120" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrencyOption}" />
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="Units" Foreground="White"/>
                      <ComboBox Width="120" ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnitOption}" />
					</StackPanel>

				</StackPanel>
		</Border>

     </Grid>
	</Border>
	</UserControl>
