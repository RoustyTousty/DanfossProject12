<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeatOptimization.Presentation.ViewModels"
             x:Class="HeatOptimization.Presentation.Views.PriceDataView"
             xmlns:views="clr-namespace:HeatOptimization.Presentation.Views"
             x:DataType="vm:PriceDataViewModel"
             Background="#121216"
             Padding="24">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnDefinitions="*,Auto" Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Price Data"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="DateButton"
                    Content="Date"
                    Width="120"
                    Background="#3E4452"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="8,4"
                    HorizontalAlignment="Right"
                    Click="DateButton_Click"/>

            <Popup x:Name="DatePopup"
                   PlacementTarget="{Binding ElementName=DateButton}"
                   Placement="Bottom">
                <Border Background="#1E1E24"
                        BorderBrush="#2D2D35"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Width="380"
                        MinWidth="320">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Select date range"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <TextBlock Text="From"
                                       Foreground="#9BA1B0"
                                       VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Grid.Column="1"
                                        Width="240"/>

                            <TextBlock Text="To"
                                       Foreground="#9BA1B0"
                                       VerticalAlignment="Center"
                                       Grid.Row="1"/>
                            <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Width="240"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                            <Button Content="Clear"
                                    Width="80"
                                    Background="#2C2F36"
                                    Foreground="White"
                                    CornerRadius="8"
                                    Click="ClearDateRange_Click"/>
                            <Button Content="Apply"
                                    Width="80"
                                    Background="#3E4452"
                                    Foreground="White"
                                    CornerRadius="8"
                                    Click="ApplyDateRange_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,24">
            <Border Background="#1E1E24" CornerRadius="12" Padding="18" MinWidth="180" BorderBrush="#2D2D35" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CO2 Prod., kg" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalCO2}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Background="#1E1E24" CornerRadius="12" Padding="18" MinWidth="180" BorderBrush="#2D2D35" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total cost (currency)" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalCost}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Background="#1E1E24" CornerRadius="12" Padding="18" MinWidth="180" BorderBrush="#2D2D35" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Maintenance op. cost" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding MaintenanceCost}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Background="#1E1E24" CornerRadius="12" Padding="18" MinWidth="180" BorderBrush="#2D2D35" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total heat produced" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalHeatProduced}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <Border Background="#1E1E24" CornerRadius="18" Padding="22" BorderBrush="#2D2D35" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="16">
                        <TextBlock Text="Unit production chart"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding DateRange}"
                                   Foreground="#9BA1B0"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"/>

                        <views:ChartView Grid.Row="1" Grid.ColumnSpan="2" Height="320" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <Border Background="#1E1E24" CornerRadius="18" Padding="22" BorderBrush="#2D2D35" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Individual Unit Performance"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <Border Background="#141418" CornerRadius="12" BorderBrush="#2D2D35" BorderThickness="1" Padding="12">
                            <Grid ColumnDefinitions="180,120,120,120,140">
                                <TextBlock Text="Unit" Foreground="#9BA1B0" FontWeight="SemiBold"/>
                                <TextBlock Text="Total Heat MW" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="1"/>
                                <TextBlock Text="Hours active" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="2"/>
                                <TextBlock Text="Total el. MW" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="3"/>
                                <TextBlock Text="Total Price" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="4"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding UnitRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UnitDataRow">
                                    <Border Background="#1C1C24" Padding="12" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="180,120,120,120,140">
                                            <TextBlock Text="{Binding Unit}" Foreground="{Binding Colour}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TotalHeat, StringFormat=N1}" Foreground="White" Grid.Column="1"/>
                                            <TextBlock Text="{Binding HoursActive}" Foreground="White" Grid.Column="2"/>
                                            <TextBlock Text="{Binding TotalElectricity, StringFormat=N1}" Foreground="White" Grid.Column="3"/>
                                            <TextBlock Text="{Binding TotalPrice, StringFormat=N0}" Foreground="White" Grid.Column="4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E24" CornerRadius="18" Padding="22" BorderBrush="#2D2D35" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
                            <TextBlock Text="Hourly Data"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBox Text="{Binding HourlySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Search" Grid.Column="1" Width="220"
                                     Background="#23232A"
                                     Foreground="White"
                                     CornerRadius="8"
                                     Padding="10,8"/>
                        </Grid>

                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="200,*" ColumnSpacing="0" RowSpacing="0">
                            <Border Background="#141418" CornerRadius="12,12,0,0" Padding="12" Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="From" Foreground="#9BA1B0" FontWeight="SemiBold"/>
                            </Border>

                            <ScrollViewer x:Name="HeaderScrollViewer" Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                                <Grid ColumnDefinitions="200,150,150,150,200,120,150" Height="40">
                                    <TextBlock Text="To" Foreground="#9BA1B0" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                    <TextBlock Text="Heat Demand MW" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="1" Margin="0,0,12,0"/>
                                    <TextBlock Text="Price" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="2" Margin="0,0,12,0"/>
                                    <TextBlock Text="Unit" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="3"/>
                                    <TextBlock Text="Production Distrib." Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="4" Margin="0,0,12,0"/>
                                    <TextBlock Text="CO2 (kg)" Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="5" Margin="0,0,12,0"/>
                                    <TextBlock Text="Elec. Cons." Foreground="#9BA1B0" FontWeight="SemiBold" Grid.Column="6"/>
                                </Grid>
                            </ScrollViewer>

                            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="260">
                                <Grid ColumnDefinitions="200,*">
                                    <Border Background="#141418" Grid.Column="0">
                                        <ItemsControl ItemsSource="{Binding FilteredHourlyRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HourlyDataRow">
                                                    <Border Background="#1C1C24" Padding="12" Margin="0,0,0,1">
                                                        <TextBlock Text="{Binding From}" Foreground="White"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <ScrollViewer x:Name="RightDataScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding FilteredHourlyRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:HourlyDataRow">
                                                        <Border Background="#1C1C24" Padding="12" Margin="0,0,0,1">
                                                            <Grid ColumnDefinitions="200,150,150,150,200,120,150">
                                                                <TextBlock Text="{Binding To}" Foreground="White"/>
                                                                <TextBlock Text="{Binding HeatDemand, StringFormat=N1}" Foreground="White" Grid.Column="1"/>
                                                                <TextBlock Text="{Binding Price}" Foreground="White" Grid.Column="2"/>
                                                                <TextBlock Text="{Binding Unit}" Foreground="#9BA1B0" Grid.Column="3"/>
                                                                <TextBlock Text="{Binding ProductionDistribution}" Foreground="White" Grid.Column="4"/>
                                                                <TextBlock Text="{Binding CO2Emission, StringFormat=N0}" Foreground="White" Grid.Column="5"/>
                                                                <TextBlock Text="{Binding ElectricityConsumption, StringFormat=N1}" Foreground="White" Grid.Column="6"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
