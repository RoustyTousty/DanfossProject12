<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeatOptimization.Presentation.ViewModels"
             x:Class="HeatOptimization.Presentation.Views.PriceDataView"
             xmlns:views="clr-namespace:HeatOptimization.Presentation.Views"
             x:DataType="vm:PriceDataViewModel"
             Background="#121216">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Text="Price Data"
                   Grid.Row="0" Grid.Column="0"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   VerticalAlignment="Top"
                   Margin="0,0,0,32"/>

        <!-- Custom Date Popup -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                <Button x:Name="DateButton"
                    Content="Date"
                    Width="120"
                    Background="#3E4452"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="8,4"
                    Click="DateButton_Click"/>
                     <Popup PlacementTarget="{Binding #DateButton, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                         Placement="Bottom"
                         IsOpen="False"
                         x:Name="DatePopup">
                <Border Background="#23232A" CornerRadius="10" Padding="16" MinWidth="260" MinHeight="240" BorderBrush="#888" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Date" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="White"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <!-- Month Dropdown -->
                            <ComboBox Width="70"
                                      Background="#3E4452"
                                      Foreground="White"
                                      CornerRadius="6"
                                      Padding="4,2"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Sep"/>
                                <ComboBoxItem Content="Oct"/>
                                <ComboBoxItem Content="Nov"/>
                            </ComboBox>
                            <!-- Year Dropdown -->
                            <ComboBox Width="70"
                                      Background="#3E4452"
                                      Foreground="White"
                                      CornerRadius="6"
                                      Padding="4,2"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="2025"/>
                                <ComboBoxItem Content="2026"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- Days Grid -->
                        <UniformGrid Columns="7" Rows="5" Margin="0,0,0,0">
                            <Button Content="1" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="2" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="3" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="4" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="5" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="6" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="7" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="8" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="9" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="10" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="11" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="12" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="13" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="14" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="15" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="16" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="17" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="18" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="19" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="20" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="21" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="22" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="23" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="24" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="25" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="26" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="27" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="28" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="29" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="30" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                            <Button Content="31" Background="#23232A" Foreground="White" Margin="2" Click="DayButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Data categories -->

        <Grid Grid.Row="1" 
              Grid.ColumnSpan="2"
              Margin="10,0,10,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  
                <ColumnDefinition Width="0.5*"/> 
                <ColumnDefinition Width="2*"/>  
                <ColumnDefinition Width="0.5*"/> 
                <ColumnDefinition Width="2*"/>  
                <ColumnDefinition Width="0.5*"/> 
                <ColumnDefinition Width="2*"/> 
            </Grid.ColumnDefinitions>
            
            
            <Border Grid.Column="0" Background="#1E1E24" CornerRadius="12" Padding="20,15" MinWidth="160" BorderBrush="#2D2D35" BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Ctgry 1" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Data 1" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

            </Border>

            
            <Border Grid.Column="2" Background="#1E1E24" CornerRadius="12" Padding="20,15" MinWidth="160" BorderBrush="#2D2D35" BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Ctgry 2" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Data 2" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

            </Border>

           
            <Border Grid.Column="4" Background="#1E1E24" CornerRadius="12" Padding="20,15" MinWidth="160" BorderBrush="#2D2D35" BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Ctgry 3" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Data 3" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

            </Border>

           
            <Border Grid.Column="6" Background="#1E1E24" CornerRadius="12" Padding="20,15" MinWidth="160" BorderBrush="#2D2D35" BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Ctgry 4" Foreground="#9BA1B0" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Data 4" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

            </Border>

        </Grid>

        <!-- Main Content Area (empty for now) -->

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="Transparent">
            <views:ChartView />
        </Border>
    </Grid>

</UserControl>