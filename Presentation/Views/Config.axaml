<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HeatOptimization.Presentation.Views"
        
        x:Class="HeatOptimization.Presentation.Views.Config"
        
        Title="Configuration" Width="420" Height="650">

    <Border Padding="30">
        <StackPanel Spacing="25">
            
            <TextBlock Text="Configure the optimization" 
                       FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>

            <DockPanel>
                <TextBlock Text="Pick a file with hourly data:" VerticalAlignment="Center"/>

                <Button Content="Select" Name="FileSelectBtn" 
                        HorizontalAlignment="Right"
                        Padding="15,5" 
                        CornerRadius="8"
                        Background="Transparent" 
                        BorderBrush="White" BorderThickness="1"
                        Click="OnFileSelectClick"/>

            </DockPanel>

            <StackPanel Spacing="10">
                <DockPanel>
                    <TextBlock Text="Pick a unit to put on maintenance:"/>
                    
                    <!-- There will be active and inactive units -->

                </DockPanel>

                <TextBlock Text="Maintenace time (30-60h):" FontSize="12"/>

                <Grid>

                    <!-- Slider for Maintenance time -->
                    
                </Grid>

            </StackPanel>

            <StackPanel Spacing="15">
                
                <!-- Date selector -->
            
            </StackPanel>

            <StackPanel Spacing="10">
                
                <!-- Slider for "Prioritize Optimization" -->

            </StackPanel>

            <Button Content="Optimize" 
                    HorizontalAlignment="Center" 
                    Padding="40,10" 
                    Background="White" Foreground="Black" 
                    FontWeight="Bold" CornerRadius="8"
                    Margin="0,20,0,0"
                    Click="OnOptimizeClick"/>

        </StackPanel>

    </Border>
</Window>