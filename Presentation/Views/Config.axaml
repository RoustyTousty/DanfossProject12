                        <TextBox Grid.Column="0" Watermark="HH"  
                                Classes="dateBox"/>

                        <TextBox Grid.Column="1" Watermark="DD"  
                                Classes="dateBox"/>

                        <TextBox Grid.Column="2" Watermark="MM" 
                                Classes="dateBox"/>

                        <TextBox Grid.Column="3" Watermark="YYYY" 
                                Classes="dateBox"/>
                        
                        <Button Grid.Column="4" Classes="dateSelect">
                            <Image Source="avares://Presentation/Assets/calendarIcon.png"
                                   Width="18" Height="18"/>
                        </Button>

                    </Grid>

                </StackPanel>
   
            
            </StackPanel> -->

            <!-- Slider for prioritization -->

            <StackPanel Spacing="10">

                <TextBlock Text="Prioritize optimization for (%):"
                            FontSize="15"
                            Margin="0,0,0,-8"/>

                <Grid ColumnDefinitions="*,80"
                        ColumnSpacing="16"
                        VerticalAlignment="Top">

                    <StackPanel Grid.Column="0">
                        <Slider 
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding CostToCO2Ratio}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Height="40"
                                Margin="0,0,0,-10"/> 
                                
                        <DockPanel LastChildFill="False" Margin="2,10">

                            <TextBlock DockPanel.Dock="Left" 
                                        Text="Price" 
                                        FontSize="12" 
                                        Foreground="#888888"/>

                            <TextBlock DockPanel.Dock="Right" 
                                        Text="CO2 Em." 
                                        FontSize="12" 
                                        Foreground="#888888"/>
                        </DockPanel>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F2F2F2"
                            CornerRadius="8"
                            Height="30"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0">

                    <TextBox Text="{Binding CostToCO2Ratio, TargetNullValue='0', FallbackValue='0'}"
                             Tag="0"
                             LostFocus="TextBox_LostFocus"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#2E2E2E"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>

                    </Border>

                </Grid>

            </StackPanel>
            
            <Button Content="Optimize"
                    HorizontalAlignment="Center" 
                    Padding="40,10" 
                    Background="White" Foreground="Black" 
                    FontWeight="Bold" CornerRadius="8"
                    Margin="0,20,0,0"/>
            
        </StackPanel>

    </Border>
</Window>